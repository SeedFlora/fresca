benchmark/cache/
benchmark/cache_us8k/

# --- build artifacts ---
benchmark/results/onnx/
benchmark/__pycache__/
__pycache__/
*.pyc
*.pyo

# --- LaTeX intermediates ---
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/_pdftext.txt

